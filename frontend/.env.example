# Default: browser /api requests are proxied to the existing local backend.
CARECOMPASS_API_TARGET=http://127.0.0.1:8000
# Explicit offline demo only (never silently used after an API failure).
VITE_DEMO_MODE=false
# Vercel Services uses /api by default; do not set VITE_API_BASE_URL there.
# Optional absolute API URL only for a separately hosted backend. Requires backend CORS.
# VITE_API_BASE_URL=https://your-api.example.com
# Never put Gemini keys in VITE_* variables; they are public browser values.
# BACKEND_URL is injected into the Vercel Node gateway service by its service binding.
# Do not set it manually or expose it with a VITE_* prefix.

# Server-only Sarvam voice. Add the real key to .env.local, never VITE_*.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=ritu
# Same-server production voice adapter (HTTPS origin, no trailing slash).
# VOICE_PUBLIC_ORIGIN=https://care.example.com
