# Default: browser /api requests are proxied to the existing local backend.
CARECOMPASS_API_TARGET=http://127.0.0.1:8000
# Explicit offline demo only (never silently used after an API failure).
VITE_DEMO_MODE=false
# Optional absolute API URL for a deployed backend. Requires backend CORS.
# VITE_API_BASE_URL=https://your-api.example.com
# Never put Gemini keys in VITE_* variables; they are public browser values.
