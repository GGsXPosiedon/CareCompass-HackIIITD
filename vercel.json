{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "devCommand": "npm run dev:services",
      "outputDirectory": "dist",
      "bindings": [
        { "type": "service", "service": "backend", "format": "url", "env": "BACKEND_URL" }
      ],
      "functions": {
        "api/care.mjs": { "maxDuration": 60 },
        "api/voice.mjs": { "maxDuration": 30 }
      },
      "rewrites": [
        { "source": "/(care|bookings|briefcase|services|history|settings)", "destination": "/index.html" },
        { "source": "/chat/:id", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/voice", "destination": { "service": "frontend", "path": "/api/voice" } },
    { "source": "/api/(.*)", "destination": { "service": "frontend", "path": "/api/care" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
