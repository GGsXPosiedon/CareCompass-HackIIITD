{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    },
    "gateway": {
      "root": "frontend",
      "framework": "node",
      "entrypoint": "server/gateway.mjs",
      "installCommand": "npm ci",
      "buildCommand": "node --check server/gateway.mjs",
      "bindings": [
        { "type": "service", "service": "backend", "format": "url", "env": "BACKEND_URL" }
      ],
      "functions": {
        "server/gateway.mjs": { "maxDuration": 60 }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "devCommand": "npm run dev -- --mode services",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(care|bookings|briefcase|services|history|settings)", "destination": "/index.html" },
        { "source": "/chat/:id", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "gateway" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
