# Copy to backend/.env (git-ignored) and fill in. Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=low
# 0 = no "thinking" (fastest); -1 = model default. Some models (e.g. 2.5-pro) do not accept 0.
GEMINI_THINKING_BUDGET=0
# --- Optional extra LLM providers (each decision - safety screen, triage - gets its own ordered chain) ---
# With 2+ providers configured the two calls start on different keys by default and fall through on errors/rate limits.
# GEMINI_API_KEY_2= ""           # a second Gemini key (e.g. another Google project)
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# COMPAT_API_KEY=              # any OpenAI-compatible API (OpenRouter, Together, a local server...)
# COMPAT_BASE_URL=https://openrouter.ai/api/v1
# COMPAT_MODEL=
# Chains: comma list of gemini, gemini2, groq, compat. Empty = automatic.
# LLM_SAFETY_CHAIN=gemini,groq
# LLM_TRIAGE_CHAIN=groq,gemini
# auto = Gemini when a key is set, otherwise off. Values: auto | gemini | off
LLM_BACKEND=auto
# Deterministic classifier slot. Values: rules | trained
# trained = rules first, then the e5 care-type head + emergency score (app/models/router_e5_lr.json).
# Needs: pip install onnxruntime tokenizers numpy  (uv sync --extra encoder) and ENCODER_PATH below.
# Falls back to rules automatically if the packages or model folder are missing.
ROUTER_BACKEND=rules
# Folder of multilingual-e5-base (with onnx/ inside)
# ENCODER_PATH=
# Emergency score thresholds (defaults come from the trained artifact)
# EMERGENCY_TAU_ASK=0.15
# EMERGENCY_TAU_ESCALATE=0.65
# How the classifier and LLM are combined: llm_first | model_first | agree_or_ask
FUSION_POLICY=llm_first
# Classifier confidence at which it may override / pre-empt the LLM
MODEL_TRUST_THRESHOLD=0.85

# Default roster: app/data/caregivers.csv (the supplied 60-caregiver CSV).
# CAREGIVERS_PATH=/absolute/path/to/another/roster.csv
