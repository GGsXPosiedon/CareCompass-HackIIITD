# Copy to backend/.env (git-ignored) and fill in. Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 0 = no "thinking" (fastest); -1 = model default. Some models (e.g. 2.5-pro) do not accept 0.
GEMINI_THINKING_BUDGET=0
# auto = Gemini when a key is set, otherwise off. Values: auto | gemini | off
LLM_BACKEND=auto
# Deterministic classifier slot (your trained model goes here later). Values: rules | <your model name>
ROUTER_BACKEND=rules
# How the classifier and LLM are combined: llm_first | model_first | agree_or_ask
FUSION_POLICY=llm_first
# Classifier confidence at which it may override / pre-empt the LLM
MODEL_TRUST_THRESHOLD=0.85
