# Set CARECOMPASS_DOMAIN (hostname only) and CARECOMPASS_DIST (absolute frontend/dist path).
{$CARECOMPASS_DOMAIN} {
    encode zstd gzip

    handle /api/voice {
        reverse_proxy 127.0.0.1:3001
    }

    handle_path /api/* {
        header Cache-Control "no-store"
        reverse_proxy 127.0.0.1:8000
    }

    handle /assets/* {
        root * {$CARECOMPASS_DIST}
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        root * {$CARECOMPASS_DIST}
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
