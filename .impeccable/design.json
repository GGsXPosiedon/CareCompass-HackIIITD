  "narrative": {
    "northStar": "A quiet conversation toward care",
    "overview": "CareCompass uses a dark, spacious conversational shell with a warm serif question and restrained sans-serif controls. The approved ChatGPT-like spatial model and Claude-like type character guide the primary experience; Lora is an open-source approximation of that serif character. The original compass mark and CareCompass name remain the identity anchors.\n\nA compact sidebar holds navigation while the canvas gives the current care decision room. Tonal surfaces, visible input labels and brief supporting text keep the experience calm and readable. The secondary family workspace deliberately retains its inherited light, green-accented interface; it is a distinct workspace within the same product.",
    "keyCharacteristics": [
      "Warm charcoal surfaces with soft paper-colored text.",
      "Serif questions paired with clear sans-serif controls.",
      "A raised composer and restrained terracotta interaction accents.",
      "Flat cards and visible selected, disabled, loading and error states.",
      "A separately scoped light family workspace."
    ],
    "rules": [
      {
        "name": "The Two Worlds Rule",
        "body": "Keep dark care tokens in the conversational flow and light family tokens in the family workspace; preserve the explicit theme boundary.",
        "section": "colors"
      },
      {
        "name": "The Question Voice Rule",
        "body": "Use the serif for primary care questions and workflow page headings; keep controls and detailed supporting information in the sans-serif.",
        "section": "typography"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Use surface tone and borders for everyday hierarchy; reserve the established ambient shadow for dialogs.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the Two Worlds Rule when extending care or family surfaces.",
      "**Do** pair serif care questions with sans-serif controls and detailed information.",
      "**Do** use tonal layers and borders for resting surfaces.",
      "**Do** show distinct focus, selected, disabled, loading and error states.",
      "**Do** keep Hindi glyph coverage, visible labels and keyboard navigation.",
      "**Do** retain plain demo disclosures and emergency emphasis."
    ],
    "donts": [
      "**Don't** introduce decorative imagery or gradients into the approved primary conversational world.",
      "**Don't** turn the intake into a feature-card dashboard or fabricate conversation history.",
      "**Don't** replace the original compass identity or imply proprietary Claude fonts are bundled.",
      "**Don't** promote inherited incidental labels or one-off styling into new system rules."
    ]
  }
}
