      "css": ".ds-nav{display:flex;flex-direction:column;gap:4px;padding:14px;background:#181817}.ds-nav button{display:flex;align-items:center;gap:12px;min-height:46px;padding:11px 13px;text-align:left;font:400 14px/1.55 'Instrument Sans','Noto Sans Devanagari',sans-serif;border:0;border-radius:8px;background:transparent;color:#b2b0a8;cursor:pointer;transition:background .15s ease,color .15s ease}.ds-nav button[aria-current]{background:#2b2b28;color:#eeece6}.ds-nav button:hover{background:#252523;color:#eeece6}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-send:focus-visible,.ds-nav button:focus-visible,.ds-prompt:focus-visible,.ds-choice:focus-visible{outline:3px solid #dfab8d;outline-offset:4px}"
