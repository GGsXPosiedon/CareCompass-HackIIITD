      "name": "Workflow Primary",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The next action in the care workflow.",
      "html": "<button class=\"ds-primary\">Continue</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:12px;border:1px solid transparent;border-radius:100px;min-height:48px;padding:12px 23px;font:500 15px/1.4 'Instrument Sans','Noto Sans Devanagari',sans-serif;cursor:pointer;transition:background .15s ease,color .15s ease;background:#e9e4da;color:#252521}.ds-primary:hover:not(:disabled){background:#fff9f0}.ds-primary:active:not(:disabled){transform:translateY(1px)}.ds-primary:disabled{color:#aba99f;background:#383833;border-color:#494942;cursor:not-allowed}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-send:focus-visible,.ds-nav button:focus-visible,.ds-prompt:focus-visible,.ds-choice:focus-visible{outline:3px solid #dfab8d;outline-offset:4px}"
    },
